DATABASE_URL="file:./dev.db"

# AI provider: openai | anthropic | gemini | ollama | nim | openrouter | local (default)
AI_PROVIDER=local
# OpenAI-compatible (also used by nim/openrouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1


# Google Places (API "Places API (New)"): place search, hotels and plans for
# cities the curated guide does not cover. Leave empty to use the guide only.
# Keep it server-side; never put it in an EXPO_PUBLIC_ variable.
GOOGLE_PLACES_API_KEY=
